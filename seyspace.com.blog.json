{
  "providerId": "seyspace.com",
  "providerName": "SeySpace",
  "serviceId": "blog",
  "serviceName": "SeySpace Photographer Blog",
  "version": 1,
  "logoUrl": "https://seyspace.com/favicon.ico",
  "description": "Connects your domain or subdomain to your SeySpace Photographer Blog.",
  "syncPubKeyDomain": "seyspace.com",
  "syncRedirectDomain": "seyspace.com",
  "variableDescription": {
    "host": "The host or subdomain to route to your SeySpace Blog (e.g. @ or journal)",
    "cname": "The SeySpace edge CNAME target (cname.vercel-dns.com)",
    "ip": "The SeySpace Anycast A-Record IP (76.76.21.21)"
  },
  "records": [
    {
      "type": "CNAME",
      "name": "%host%",
      "target": "%cname%",
      "ttl": 300,
      "subDomain": "%host%",
      "groupId": "subdomain"
    },
    {
      "type": "A",
      "name": "@",
      "target": "%ip%",
      "ttl": 300,
      "subDomain": "",
      "groupId": "apex"
    }
  ]
}
